# GeoEyes settings -- copy to .env (same folder) and fill in what this machine needs.
# .env is gitignored: never commit it. A real environment variable with the same name takes precedence.

# Workspace root: archive/, cache/, projects/<name>/ (stacks, ps_runs, products, exports, runs)
GEOEYES_WORKSPACE=D:/projects/geoeyes_workspace
# Golden / test data root (tests/golden)
GEOEYES_TEST_DATA=
# Log level of the CLI (DEBUG | INFO | WARNING)
GEOEYES_LOG_LEVEL=INFO

# NASA Earthdata token: Sentinel-1 burst downloads (phase acquire) and precise orbits (POEORB).
# Prefer a user / machine environment variable over this file.
EARTHDATA_TOKEN=

# ERA5 ([atmosphere] method = "era5") reads the Copernicus CDS key from ~/.cdsapirc, not from here.

# Python >= 3.12 with icechunk >= 2 for IMERG half-hourly rainfall (Source Cooperative), when the GeoEyes
# environment is older (icechunk 2 needs Python 3.12). Empty: GeoEyes' own interpreter.
#   conda create -p <envs>/icechunk -c conda-forge python=3.12 "icechunk>=2.3" xarray zarr numpy
GEOEYES_ICECHUNK_PYTHON=

# Web app login token, used only when `geoeyes serve --host` opens it beyond this machine (random when empty)
GEOEYES_WEB_TOKEN=
